# Template for the local .env file. Committed on purpose — it must never
# contain a real value.
#
# Setup:
#   1. cp .env.example .env
#   2. fill in the values below
#   3. .env is listed in .gitignore and must stay out of version control
#
# Everything that is not a secret — model name, endpoint, thresholds, paths —
# lives in config/settings.yaml instead.

# --------------------------------------------------------------------------- #
# Required
# --------------------------------------------------------------------------- #

# OpenRouter API key. Obtain one at https://openrouter.ai/keys
# The application refuses to start without it.
OPENROUTER_API_KEY=

# --------------------------------------------------------------------------- #
# Optional
# --------------------------------------------------------------------------- #

# Sent to OpenRouter as HTTP-Referer and X-Title. OpenRouter uses them to
# attribute traffic on its dashboards; they are not credentials.
# OPENROUTER_APP_URL=http://localhost:8000
# OPENROUTER_APP_NAME=Assistente di primo livello
